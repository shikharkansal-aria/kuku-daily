# Lint settings for this repo.
# pylint runs outside .venv here, so third-party imports do not resolve (import-error),
# and it crashes on the pydantic models (astroid-error); both are tool limits, not code faults.
# Short local names, long lines and broad excepts that keep the app usable are house style.
[FORMAT]
max-line-length=160

[MESSAGES CONTROL]
disable=invalid-name,missing-module-docstring,missing-class-docstring,missing-function-docstring,
        import-error,astroid-error,too-many-locals,too-many-arguments,too-many-positional-arguments,
        broad-exception-caught,import-outside-toplevel,wrong-import-position,wrong-import-order,
        ungrouped-imports,redefined-outer-name,unnecessary-lambda-assignment,multiple-statements,
        multiple-imports,consider-using-with,unspecified-encoding
